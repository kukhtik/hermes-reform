+# --------------------------------------------------------------------------- #
+# Test (d) — get_subprocess_env() isolation contract
+# --------------------------------------------------------------------------- #
+
+class TestSubprocessEnvIsolation:
+    """get_subprocess_env() correctly propagates HERMES_HOME to child processes.
+
+    The correct contract: get_subprocess_env() copies os.environ and sets
+    HERMES_HOME to str(get_hermes_home()).  get_hermes_home() falls back to
+    the platform default when HERMES_HOME is unset in the parent.  This means
+    a child hermes process always receives a profile home (the explicit one or
+    the platform default) — this IS the profile propagation mechanism.
+    Overrides= can change the value.  The result dict is always independent
+    from os.environ.
+    """
+
+    def test_hermes_home_set_to_computed_profile_home(self, monkeypatch):
+        """get_subprocess_env() always sets HERMES_HOME to get_hermes_home()."""
+        monkeypatch.setenv("HERMES_HOME", "C:/explicit-profile-home")
+
+        env = get_subprocess_env()
+
+        assert "HERMES_HOME" in env
+        # Use normpath to handle Windows forward/backslash normalisation
+        assert os.path.normpath(env["HERMES_HOME"]) == os.path.normpath("C:/explicit-profile-home")
+
+    def test_hermes_home_falls_back_to_platform_default_when_unset(self, monkeypatch):
+        """When HERMES_HOME is not in the parent env, child gets the platform default.
+
+        This is the correct F0.7 propagation behaviour: get_hermes_home() is
+        called in the parent process, so its fallback fires there, and the
+        result is passed to the child.  The child does not 'invent' a new home
+        — it receives the parent's computed fallback.
+        """
+        monkeypatch.delenv("HERMES_HOME", raising=False)
+
+        env = get_subprocess_env()
+
+        assert "HERMES_HOME" in env
+        # Should be the platform default, not absent
+        default_home = Path.home() / ".hermes" if os.name != "nt" else Path(
+            os.environ.get("LOCALAPPDATA", str(Path.home() / "AppData" / "Local"))
+        ) / "hermes"
+        assert os.path.normpath(env["HERMES_HOME"]) == os.path.normpath(str(default_home))
+
+    def test_overrides_can_add_hermes_home(self, monkeypatch):
+        """Explicit overrides= can set HERMES_HOME even when parent has none."""
+        monkeypatch.delenv("HERMES_HOME", raising=False)
+
+        env = get_subprocess_env(overrides={"HERMES_HOME": "C:/override-home"})
+
+        assert "HERMES_HOME" in env
+        assert os.path.normpath(env["HERMES_HOME"]) == os.path.normpath("C:/override-home")
+
+    def test_overrides_win_over_parent_hermes_home(self, monkeypatch):
+        """overrides= take precedence over the parent's HERMES_HOME value."""
+        monkeypatch.setenv("HERMES_HOME", "C:/parent-home")
+
+        env = get_subprocess_env(overrides={"HERMES_HOME": "C:/override-home"})
+
+        assert os.path.normpath(env["HERMES_HOME"]) == os.path.normpath("C:/override-home")
+
+    def test_other_env_vars_copied_from_parent(self, monkeypatch):
+        """os.environ is copied so ambient vars are present in the child env."""
+        monkeypatch.setenv("HERMES_HOME", "C:/home")
+        monkeypatch.setenv("MY_SECRET", "hunter2")
+
+        env = get_subprocess_env()
+
+        # os.environ is copied, so ambient vars are present
+        assert "MY_SECRET" in env
+        assert env["MY_SECRET"] == "hunter2"
+
+    def test_helper_result_is_independent_copy(self, monkeypatch):
+        """Each call returns a fresh dict; mutations don't affect os.environ."""
+        monkeypatch.setenv("HERMES_HOME", "C:/home")
+        env1 = get_subprocess_env()
+        env2 = get_subprocess_env()
+
+        # Both have HERMES_HOME
+        assert "HERMES_HOME" in env1
+        assert "HERMES_HOME" in env2
+
+        # But they are independent dicts — mutating one doesn't affect the other
+        env1["HERMES_HOME"] = "C:/mutated"
+        assert os.path.normpath(env2["HERMES_HOME"]) == os.path.normpath("C:/home")
+        assert os.environ.get("HERMES_HOME") == "C:/home"
