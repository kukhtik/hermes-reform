+        monkeypatch.setenv("HERMES_HOME", str(home_a))
+        path_a = get_hermes_home() / "skills"
+
+        monkeypatch.setenv("HERMES_HOME", str(home_b))
+        path_b = get_hermes_home() / "skills"
+
+        assert path_a != path_b
+        assert path_a.parent == home_a
+        assert path_b.parent == home_b
+
