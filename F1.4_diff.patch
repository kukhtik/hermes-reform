+"""F1.4 profile isolation tests.
+
+Validates that two independent HERMES_HOME profiles (A and B) maintain
+complete isolation for: sessions, skills, memories, and that
+get_subprocess_env() correctly propagates HERMES_HOME to child processes.
+
+These tests document and verify the invariants established by the F1.4
+audit (reform/f14-profile-isolation):
+  - Per-profile paths (get_hermes_home()): state.db, sessions/, skills/,
+    memories/, logs/, config.yaml, cron/, pairing/, cache/  are isolated.
+  - Intentional shared paths (version-controlled): HERMES_BUNDLED_SKILLS,
+    HERMES_OPTIONAL_SKILLS, HERMES_OPTIONAL_MCPS (repo-skills, not per-profile).
+  - get_subprocess_env() ALWAYS sets HERMES_HOME to str(get_hermes_home()),
+    which falls back to the platform default when the env var is unset.
+    This is the correct profile-propagation mechanism: child processes always
+    receive the parent's profile home (or platform default) — overrides= can
+    override this. The isolation guarantee is: without overrides=, the helper
+    does NOT invent HERMES_HOME out of thin air — it computes it from the
+    parent's environment the same way the parent would.
+"""
+
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from hermes_constants import get_hermes_home, get_subprocess_env
+
+
+# --------------------------------------------------------------------------- #
+# Fixtures
+# --------------------------------------------------------------------------- #
+
+@pytest.fixture
+def two_hermes_homes(tmp_path):
+    """Two independent HERMES_HOME directories with full directory skeleton."""
+    home_a = tmp_path / "hermes_a"
+    home_b = tmp_path / "hermes_b"
+    for home in (home_a, home_b):
+        (home / "sessions").mkdir(parents=True)
+        (home / "skills").mkdir(parents=True)
+        (home / "memories").mkdir(parents=True)
+        (home / "logs").mkdir(parents=True)
+        (home / "cache").mkdir(parents=True)
+        (home / "cron").mkdir(parents=True)
+        (home / "pairing").mkdir(parents=True)
+        (home / "state").mkdir(parents=True)
+    return home_a, home_b
+
+
+# --------------------------------------------------------------------------- #
+# Test (a) — sessions/ isolation
+# --------------------------------------------------------------------------- #
+
+class TestSessionsIsolation:
+    """sessions/ directory is not shared between profiles."""
+
+    def test_session_created_in_a_not_visible_in_b(self, two_hermes_homes, monkeypatch):
+        home_a, home_b = two_hermes_homes
+
+        # Profile A: write a session file
+        monkeypatch.setenv("HERMES_HOME", str(home_a))
+        session_a_path = home_a / "sessions" / "test_session.jsonl"
+        session_a_path.write_text(
+            json.dumps({"id": "sess-A", "messages": [{"role": "user", "content": "hello"}]}),
+            encoding="utf-8",
+        )
+
+        # Profile B: should not see A's sessions
+        monkeypatch.setenv("HERMES_HOME", str(home_b))
+        b_sessions = list((home_b / "sessions").iterdir())
+
+        assert not any(
+            f.name == "test_session.jsonl" for f in b_sessions
+        ), "Profile B must not see Profile A's session files"
+
+    def test_sessions_dirs_are_different_paths(self, two_hermes_homes, monkeypatch):
+        """get_hermes_home() resolves to different sessions/ for each profile."""
+        home_a, home_b = two_hermes_homes
+
+        monkeypatch.setenv("HERMES_HOME", str(home_a))
+        path_a = get_hermes_home() / "sessions"
+
+        monkeypatch.setenv("HERMES_HOME", str(home_b))
+        path_b = get_hermes_home() / "sessions"
+
+        assert path_a != path_b
+        assert path_a.parent == home_a
+        assert path_b.parent == home_b
+
+
+# --------------------------------------------------------------------------- #
+# Test (b) — skills isolation
+# --------------------------------------------------------------------------- #
+
+class TestSkillsIsolation:
+    """skills/ directory is not shared between profiles."""
+
+    def test_skill_file_created_in_a_not_visible_in_b(self, two_hermes_homes, monkeypatch):
